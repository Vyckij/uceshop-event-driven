# =====================================================================
# UCEShop · Variables de entorno (PLANTILLA)
#
# 1) Copia este archivo:   cp .env.example .env
# 2) Cambia las contraseñas en .env si quieres
# 3) NUNCA subas .env a GitHub (debe estar en .gitignore)
#
# Reglas del formato:
#   - Una variable por línea:  NOMBRE=valor
#   - Sin espacios alrededor del "="
#   - En contraseñas usa solo letras, números y guion bajo
#     (evita $  #  comillas y espacios)
# =====================================================================

# ---------------------------------------------------------------------
# Versiones de las imágenes (nunca uses "latest")
# ---------------------------------------------------------------------
KAFKA_IMAGE_TAG=4.3.1
RABBITMQ_IMAGE_TAG=4.3-management
POSTGRES_IMAGE_TAG=18-alpine

# ---------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------
# Identificador único del cluster KRaft (22 caracteres, formato base64).
# No lo cambies después de arrancar Kafka por primera vez.
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
# Puerto en tu PC para conectarte desde el IDE o herramientas externas
KAFKA_EXTERNAL_PORT=9094

# ---------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------
RABBITMQ_USER=uceshop
RABBITMQ_PASSWORD=rabbit_local_123
RABBITMQ_AMQP_PORT=5672
RABBITMQ_UI_PORT=15672

# ---------------------------------------------------------------------
# PostgreSQL · producerdb (solo la usa producer-service)
# ---------------------------------------------------------------------
PRODUCER_DB_NAME=producerdb
PRODUCER_DB_USER=producer_user
PRODUCER_DB_PASSWORD=producer_local_123
PRODUCER_DB_PORT=5433

# ---------------------------------------------------------------------
# PostgreSQL · consumerdb (solo la usa consumer-service)
# ---------------------------------------------------------------------
CONSUMER_DB_NAME=consumerdb
CONSUMER_DB_USER=consumer_user
CONSUMER_DB_PASSWORD=consumer_local_123
CONSUMER_DB_PORT=5434

APP_VERSION=1.0.0

PRODUCER_SERVICE_PORT=8080
CONSUMER_SERVICE_PORT=8081

KAFKA_TOPIC_ORDERS=orders
KAFKA_GROUP_ID=consumer-service-group

PROMETHEUS_IMAGE_TAG=v3.13.4
GRAFANA_IMAGE_TAG=13.2
KAFKA_EXPORTER_IMAGE_TAG=v1.10.0

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_local_123

DASHBOARD_PORT=8088