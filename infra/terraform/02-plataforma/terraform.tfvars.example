# =====================================================================
# 02-plataforma · valores del entorno (PLANTILLA)
#
# 1) Copia este archivo como terraform.tfvars
# 2) Cambia admin_cidrs por tu IP pública (https://checkip.amazonaws.com)
# 3) terraform.tfvars NO se sube a GitHub
#
# Para otra cuenta o región solo cambias este archivo y las credenciales.
# =====================================================================

# ---------- General ----------
aws_region  = "us-east-1"
project     = "uceshop"
environment = "academy"

extra_tags = {
  Course = "Caso Practico 2"
}

# ---------- Red (2 zonas = alta disponibilidad) ----------
availability_zones  = ["us-east-1a", "us-east-1b"]
vpc_cidr            = "10.0.0.0/16"
public_subnet_cidrs = ["10.0.0.0/24", "10.0.1.0/24"]
data_subnet_cidrs   = ["10.0.20.0/24", "10.0.21.0/24"]

# Tu IP pública con /32. Puedes agregar la de tu grupo separada por comas.
admin_cidrs = ["203.0.113.10/32"]

service_namespace = "uceshop.local"

# ---------- Bases de datos ----------
databases = {
  producer = { db_name = "producerdb", username = "producer_user", az_index = 0 }
  consumer = { db_name = "consumerdb", username = "consumer_user", az_index = 1 }
}

# Antes del primer apply, cambia "18" por la versión completa más reciente:
# aws rds describe-db-engine-versions --engine postgres --query "DBEngineVersions[?starts_with(EngineVersion,'18.')].EngineVersion" --output text
db_engine_version             = "18"
db_instance_class             = "db.t4g.micro"
db_allocated_storage          = 20
db_max_allocated_storage      = 0
db_storage_type               = "gp2" # Learner Lab solo admite gp2
db_storage_encrypted          = true
db_multi_az                   = false # Learner Lab no admite Multi-AZ; en otra cuenta, true = alta disponibilidad
db_backup_retention_days      = 1
db_backup_window              = "07:00-07:30"         # UTC = 02:00 en Ecuador
db_maintenance_window         = "sat:08:00-sat:08:30" # UTC = sábado 03:00 en Ecuador
db_auto_minor_version_upgrade = false
db_deletion_protection        = false # true en producción
db_skip_final_snapshot        = true  # false en producción

password_length = 24

# ---------- ECS ----------
ecs_container_insights        = "disabled"
ecs_default_capacity_provider = "FARGATE"
